# Autenticação mockada de demonstração.
# Desativada por padrão: habilite apenas em ambientes de demonstração.
AUTH_MOCK_ENABLED=false

# Segredo HMAC usado para assinar o cookie de sessão (mínimo 32 bytes).
# Gere um valor aleatório localmente, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca versione o valor real.
AUTH_SECRET=
